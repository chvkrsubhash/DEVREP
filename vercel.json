{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.ts"
    },
    {
      "source": "/auth/:path*",
      "destination": "/api/index.ts"
    },
    {
      "source": "/((?!api|auth|assets|favicon.ico).*)",
      "destination": "/index.html"
    }
  ]
}
