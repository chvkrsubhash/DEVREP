{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "/api"
    },
    {
      "source": "/auth/:match*",
      "destination": "/api"
    },
    {
      "source": "/((?!api|auth|assets).*)",
      "destination": "/index.html"
    }
  ]
}
